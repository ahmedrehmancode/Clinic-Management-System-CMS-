@model IEnumerable<CMS_Clinic_Management_System_.Models.Client>
@{
    ViewData["Title"] = "Clients List";
}

<h2>Clients</h2>

<p>
    <a href="@Url.Action("Create", "Client")" class="btn btn-primary">
        <i class="fas fa-user-plus"></i> Add New Client
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var client in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@client.Name</td>
                    <td>@client.Email</td>
                    <td>@client.Phone</td>
                    <td>@client.Address</td>
                    <td>
                        <a href="@Url.Action("Edit", "Client", new { id = client.Id })" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a href="@Url.Action("Delete", "Client", new { id = client.Id })" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this client?');">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No clients found.</td>
            </tr>
        }
    </tbody>
</table>
