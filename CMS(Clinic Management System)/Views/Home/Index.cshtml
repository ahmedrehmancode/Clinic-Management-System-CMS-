                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card equipment-card">
                        <div class="card-header">
                            <div class="equipment-icon">💓</div>
                            <span class="badge">Diagnostic</span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">ECG Machine</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="price">$2,499</div>
                                <button class="btn btn-primary btn-sm">Add to Cart</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card equipment-card">
                        <div class="card-header">
                            <div class="equipment-icon">🔬</div>
                            <span class="badge">Surgical</span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Surgical Kit</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="price">$599</div>
                                <button class="btn btn-primary btn-sm">Add to Cart</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card equipment-card">
                        <div class="card-header">
                            <div class="equipment-icon">📡</div>
                            <span class="badge">Imaging</span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Ultrasound Scanner</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="price">$4,999</div>
                                <button class="btn btn-primary btn-sm">Add to Cart</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center mt-4">
                <button class="btn btn-outline-primary">View All Products</button>
            </div>
        </div>
    </section>

