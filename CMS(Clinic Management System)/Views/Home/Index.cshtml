                                    <i class="fas fa-users me-2"></i>320 registered
                                    <span class="ms-3">👨‍⚕️ Dr. Michael Chen</span>
                                </div>
                            </div>
                            <div class="mt-3 mt-md-0">
                                <button class="btn btn-outline-primary btn-sm me-2">
                                    <i class="fas fa-play"></i> Preview
                                </button>
                                <button class="btn btn-primary btn-sm">Register Now</button>
                            </div>
                        </div>
                    </div>
                    <div class="seminar-card">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="mb-2">
                                    <span class="seminar-type">Lecture</span>
                                    <span class="ms-3 text-muted">🗓️ Feb 10, 2026 • 3:00 PM EST</span>
                                </div>
                                <h3>Medical Equipment Maintenance</h3>
                                <div class="text-muted">
                                    <i class="fas fa-users me-2"></i>280 registered
                                    <span class="ms-3">👨‍⚕️ Prof. Emily Roberts</span>
                                </div>
                            </div>
                            <div class="mt-3 mt-md-0">
                                <button class="btn btn-outline-primary btn-sm me-2">
                                    <i class="fas fa-play"></i> Preview
                                </button>
                                <button class="btn btn-primary btn-sm">Register Now</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
