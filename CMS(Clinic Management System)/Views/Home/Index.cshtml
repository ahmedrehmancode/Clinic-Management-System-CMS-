@{
    Layout = "_Navbar";
}
    <title>Home</title>
<body>
  
    <!-- Hero Section -->
    <section id="home" class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1>Premium Medical Equipment for Healthcare Professionals</h1>
                    <p>Discover cutting-edge medical devices and join expert-led seminars to advance your practice.</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <button class="btn btn-white">Shop Equipment</button>
                        <button class="btn btn-outline-white">View Seminars</button>
                    </div>
                    <div class="stat-box">
                        <div class="row">
                            <div class="col-4 stat-item">
                                <div class="stat-number">500+</div>
                                <div class="stat-label">Products</div>
                            </div>
                            <div class="col-4 stat-item">
                                <div class="stat-number">50K+</div>
                                <div class="stat-label">Customers</div>
                            </div>
                            <div class="col-4 stat-item">
                                <div class="stat-number">100+</div>
                                <div class="stat-label">Seminars</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 mt-5 mt-lg-0">
                    <div class="feature-card">
                        <div class="text-center icon">🏥</div>
                        <h3 class="text-center">Industry Leading</h3>
                        <ul class="feature-list">
                            <li><i class="fas fa-award"></i> FDA Approved Equipment</li>
                            <li><i class="fas fa-users"></i> Expert-Led Training</li>
                            <li><i class="fas fa-calendar"></i> 24/7 Support</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Equipment Section -->
    <section id="equipment" class="py-5 bg-light">
        <div class="container">
            <div class="section-title">
