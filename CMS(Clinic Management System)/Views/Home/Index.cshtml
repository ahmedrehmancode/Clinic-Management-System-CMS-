@{
    Layout = "_Navbar";
}

@{
    ViewData["Title"] = "Home";
}

<!-- Bootstrap CSS -->
@section Styles {
    <link href="~/css/home.css" rel="stylesheet" />
}
<!-- Demo Hero Section -->
<div class="container">
    <div class="hero text-center">
        <h1>Welcome to Clinic Management System</h1>
        <p>Your trusted platform for medical supplies, equipment, and healthcare management solutions. Browse medicines, medical equipment, and access our comprehensive services.</p>
        <div class="mt-4">
            <button class="btn btn-auth me-2">
                <i class="fas fa-shopping-cart me-2"></i> Browse Medicines
            </button>
            <button class="btn btn-outline-primary" style="border-color: var(--primary-color); color: var(--primary-color);">
                <i class="fas fa-search me-2"></i> Find Equipment
            </button>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-pills fa-3x mb-3" style="color: var(--primary-color);"></i>
                    <h5 class="card-title">Medicines</h5>
                    <p class="card-text">Browse our comprehensive catalog of pharmaceutical products and medicines for healthcare providers.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-tools fa-3x mb-3" style="color: var(--primary-color);"></i>
                    <h5 class="card-title">Medical Equipment</h5>
                    <p class="card-text">Find high-quality medical devices, instruments, and equipment for clinics and hospitals.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-clinic-medical fa-3x mb-3" style="color: var(--primary-color);"></i>
                    <h5 class="card-title">Clinic Solutions</h5>
                    <p class="card-text">Comprehensive management solutions for healthcare facilities and medical practices.</p>
                </div>
            </div>
        </div>
    </div>
</div>