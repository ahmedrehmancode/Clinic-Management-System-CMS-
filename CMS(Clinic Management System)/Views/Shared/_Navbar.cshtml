<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Title  *@
    <title>@ViewData["Title"] | Clinic Management System</title>
   @* favicon *@
    <link rel="icon" type="image/x-icon" href="~/images/favicon.svg" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custome Css Links -->
    <link rel="stylesheet" href="~/css/navbar.css">
    @* <link href="~/css/home.css" rel="stylesheet" /> *@

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top navbar_Layout">
        <div class="container-fluid d-flex justify-content-between  ">
            <a class="navbar-brand d-flex  align-items-center" href="#">
                <!-- <i class="fas fa-clinic-medical me-2"></i> -->
                <img src="~/images/CMS.webp" alt="" width="150px" height="80px">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse " id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("index","home")"><i class="fas fa-home me-1"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="navbar.html"><i class="fas fa-pills me-1"></i> Medicines</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fas fa-tools me-1"></i> Equipment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("index","about")"><i class="fas fa-shield-alt me-1"></i> About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="fas fa-shield-alt me-1"></i> Privacy Policy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("index","contact")"><i class="fas fa-phone me-1"></i> Contact</a>
                    </li>
                </ul>

                <!-- Authentication Dropdown -->
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-auth dropdown-toggle d-flex align-items-center" type="button" id="authDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle me-2"></i> Authentication
                        </button>
                        <ul class="dropdown-menu dropdown-menu-lg-end dropdown-menu-start" aria-labelledby="authDropdown">
                            <li><h6 class="dropdown-header">Login to Your Account</h6></li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("UserLogin", "auth")" >
                                    <i class="fas fa-user-md"></i> User Login
                                    <small class="d-block text-muted mt-1">For medical professionals & customers</small>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user-shield"></i> Admin Login
                                    <small class="d-block text-muted mt-1">For system administrators</small>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user-plus"></i> Create Account
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-key"></i> Forgot Password?
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

        @RenderBody()

    <!-- Footer Section -->

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-3">
                        <i class="fas fa-clinic-medical me-2"></i>Clinic Management System
                    </h5>
                    <p>
                        Your trusted partner for medical supplies and clinic management solutions. We provide quality
                        medicines and equipment to healthcare providers nationwide.
                    </p>
                    <div class="social-icons mt-4">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>

                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-3">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#"><i class="fas fa-chevron-right me-2"></i>Medicines Catalog</a></li>
                        <li class="mb-2"><a href="#"><i class="fas fa-chevron-right me-2"></i>Medical Equipment</a></li>
                        <li class="mb-2"><a href="#"><i class="fas fa-chevron-right me-2"></i>Clinic Software</a></li>
                        <li class="mb-2"><a href="#"><i class="fas fa-chevron-right me-2"></i>About Us</a></li>
                        <li><a href="#"><i class="fas fa-chevron-right me-2"></i>Privacy Policy</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 mb-4">
                    <h5 class="text-white mb-3">Contact Info</h5>
                    <p><i class="fas fa-map-marker-alt me-2"></i>123 Medical Center Drive, Cityville 12345</p>
                    <p><i class="fas fa-phone me-2"></i>(123) 456-7890</p>
                    <p><i class="fas fa-envelope me-2"></i>info@clinicmanagement.com</p>
                    <p class="mt-4"><i class="fas fa-truck me-2"></i>Nationwide Delivery Available</p>
                </div>
            </div>

            <hr class="mt-0 mb-4" style="border-color: #555;">

            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2023 Clinic Management System. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">Designed for healthcare professionals</p>
                </div>
            </div>
        </div>
    </footer>


    <!-- Bootstrap JS with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>