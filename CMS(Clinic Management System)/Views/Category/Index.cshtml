@{
    Layout = null;
    ViewData["Title"] = "Register";
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Add Category - Clinic Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/form.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">


</head>

<body>
    <!-- Background decorations -->
    <div class="bg-decoration decoration-1"></div>
    <div class="bg-decoration decoration-2"></div>

    <div class="login-container">
        <div class="login-card">
            @* <!-- Logo -->
            <div class="logo-container">
                <img src="~/images/logo.png" alt="Clinic Management System Logo" class="logo-img">
            </div> *@

            <!-- Header -->
            @* <div class="header-section">
                <h1 class="title">Welcome</h1>
                <p class="subtitle">Create an account</p>
            </div> *@

            <!-- Form -->
            <form method="post">


                <!-- Name field -->
                <div class="form-group">
                    <label class="form-label" for="name">Clinic Name</label>
                    <div class="input-wrapper">
                        <i class="fa fa-user input-icon"></i>
                        <input type="text" class="form-control" id="name" name="ClinicName" placeholder="Name"
                               required aria-label="Name">
                    </div>
                </div>
                <!-- Address field -->
                <div class="form-group">
                    <label class="form-label" for="address">Address</label>
                    <div class="input-wrapper">
                        <i class="fas fa-location-crosshairs input-icon"></i>
                        <input type="text" class="form-control" id="address" name="Address" placeholder="Address"
                               required aria-label="Address">
                    </div>
                </div>

                <!-- Email field -->
                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" class="form-control" id="email" name="UserEmail" placeholder="Email"
                               autocomplete="email" required aria-label="Email address">
                    </div>
                </div>

                <!-- Contact field -->
                <div class="form-group">
                    <label class="form-label" for="phone">Phone</label>
                    <div class="input-wrapper">
                        <i class="fas fa-phone input-icon"></i>
                        <input type="text" class="form-control" id="phone" name="Phone" placeholder="Phone"
                               required aria-label="Phone number">
                    </div>
                </div>


                @* <!-- Password field -->
                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" class="form-control" id="password" name="UserPassword"
                               placeholder="Password" autocomplete="current-password" required
                               aria-label="Password">
                    </div>
                </div> *@


                <!-- signup button -->
                <button type="submit" class="btn-login">
                    <i class="fas fa-circle-plus"></i>
                    <span>Add</span>
                </button>
            </form>
            <div class="mt-2 con_signIn">
                <p>Back To </p>
                <button class="btn_signIn"><a href="@Url.Action("index", "admin")">Dashboard</a></button>


            </div>


            <!-- Footer -->
            <div class="footer">
                <p class="footer-text">
                    © @DateTime.Now.Year Clinic Management System. All rights reserved.
                </p>
            </div>
        </div>
    </div>
</body>

</html>