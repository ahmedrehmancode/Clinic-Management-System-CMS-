@model SignupViewModle;
@{
    Layout = null;
    ViewData["Title"] = "Register";

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Login</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @* <link rel="stylesheet" href="~/css/login.css"> *@
    <link rel="stylesheet" href="~/css/Signup.css" />
</head>
<body>



    <div class="main">
        <div class="container login-container">
            <div class="row g-0 login-card">
                <!-- Left side with benefits/info -->
                <div class="col-lg-6 login-left" id="img_login">

                    <div id="imgchild">
                    </div>
                </div>

                <!-- Right side with Signup form -->

                <div class="col-lg-6 login-right">
                   


                    <div class="login-header">
                        <h2>Create Account</h2>
                        <p>Create your account to explore medicines, equipment, and track your orders.</p>

                    </div>

                    <form method="post" asp-controller="Auth" asp-action="UserSignUp">
                        <!-- Clinic name field -->
                        <div class="mb-3">
                            <label for="ClinicName" class="form-label">Clinic Name</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa fa-user" aria-hidden="true"></i>
                                </span>

                                <input asp-for="ClinicName"
                                       placeholder="Enter Clinic Name"
                                       class="form-control">
                            </div>
                                <span asp-validation-for="ClinicName"  class="text-danger"></span>
                        </div>

              
                        <!-- Email field -->
                        <div class="mb-3">
                            <label for="Email" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <input asp-for="Email"
                                       placeholder="Enter Your email"
                                       class="form-control"
                                       >
                            </div>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                        @* <div asp-validation-summary="ModelOnly" class="text-danger"></div> *@
                        <!-- Location field -->
                        <div class="mb-3">
                            <label for="Address" class="form-label">Location</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa fa-map-marker" aria-hidden="true"></i>
                                </span>
                                <input asp-for="Address"
                                       placeholder="Location"
                                       class="form-control"
                                       >
                            </div>
                            <div asp-validation-summary="All" class="text-danger"></div>
                        <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <!-- Contact Number field -->
                        <div class="mb-3">
                            <label for="Phone" class="form-label">Contact Number</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa fa-phone" aria-hidden="true"></i>
                                </span>
                                <input asp-for="Phone"
                                       placeholder="Phone Number"
                                       class="form-control"
                                       >
                            </div>
                        </div>
                        <span asp-validation-for="Phone" class="text-danger"></span>
                        <!-- CLinicRegistration Number field -->
                        <div class="mb-3">
                            <label for="ClinicRegistraionNumber" class="form-label">Clinic Registraion Number</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fa-solid fa-n" aria-hidden="true"></i>
                                </span>
                                <input asp-for="ClinicRegistraionNumber"
                                       placeholder="Clinic Registration Number"
                                       class="form-control"
                                       >
                            </div>
                        </div>
                        <span asp-validation-for="ClinicRegistraionNumber" class="text-danger"></span>
                        <!-- Password field -->
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       id="password"
                                       name="Password"
                                       placeholder="Enter your password"
                                       >
                                <span class="input-group-text" id="togglePassword" style="cursor: pointer;" onclick="togglePassword(this)">
                                    <i class="fas fa-eye"></i>
                                </span>
                            </div>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <!-- ConfirmPassword field -->
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">ConfirmPassword</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       id="confirmPassword"
                                       name="ConfirmPassword"
                                       placeholder="Confirm your password"
                                       >
                                <span class="input-group-text" id="toggleConfirmPassword" style="cursor: pointer;" onclick="togglePassword(this)">
                                    <i class="fas fa-eye"></i>
                                </span>
                            </div>
                        </div>

                    
                       

                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        <!-- Forgot password -->
                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <a href="@Url.Action("ForgotPassword", "auth")" class="forgot-password">Forgot password?</a>
                        </div>


                        @* @if (ViewBag.erroMessage != null)
                        {
                            <div class="error">
                                Invalid credentials

                            </div> *@


                        <!-- Login button -->
                        <button type="submit" class="btn btn-login">
                            <i class="fas fa-sign-in-alt me-2"></i> SignUp
                        </button>


                    </form>

                    <!-- Sign up link -->
                    <div class="signup-link">
                        Already Have Account? <a href="@Url.Action("UserLogin", "auth")">Login here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/Login.js"></script>
</body>
</html>
