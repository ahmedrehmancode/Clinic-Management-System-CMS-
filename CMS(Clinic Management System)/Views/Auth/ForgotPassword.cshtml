@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - Clinic Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

   
</head>

<body>
    <!-- Background decorations -->
    <div class="bg-decoration decoration-1"></div>
    <div class="bg-decoration decoration-2"></div>

    <div class="login-container">
        <div class="login-card">
            <!-- Logo -->
            <div class="logo-container">
                <img src="~/images/logo.png" alt="Clinic Management System Logo" class="logo-img">
            </div>

            <!-- Header -->
            <div class="header-section">
                <h1 class="title">Verify Email</h1>
                
            </div>

            <!-- Form -->
            <form method="post">
                <!-- Error message -->
                @if (ViewBag.Messege != null)
                {
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@ViewBag.Messege</span>
                    </div>
                }

                <!-- Email Verify -->
                <div class="form-group">
                    <label class="form-label" for="email">Enter Your Email Address</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email"
                               class="form-control"
                               id="email"
                               name="email"
                               placeholder="Enter your email"
                               autocomplete="email"
                               required
                               aria-label="Email address">
                    </div>
                </div>

               
             
                <!-- Next button -->
                <button type="submit" class="btn-login">
                    <i class="fas fa-jelly-fill fa-regular fa-angle-right"></i>
                    <span>Next</span>
                </button>
            </form>
            

            <!-- Footer -->
            <div class="footer">
                <p class="footer-text">
                    © @DateTime.Now.Year Clinic Management System. All rights reserved.
                </p>
            </div>
        </div>
    </div>
</body>
</html>