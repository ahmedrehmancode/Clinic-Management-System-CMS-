@{
    Layout = "_Navbar";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>About Us | Medical Equipment & Medicine</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/styles.css" rel="stylesheet" />
    <link href="~/css/about.css" rel="stylesheet" />

    
</head>
<body>

    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <h1>About Our Medical Store</h1>
            <p class="mt-3 fs-5">
                Delivering trusted medical equipment and medicines for better healthcare
            </p>
        </div>
    </section>

    <!-- INTRO -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h2 class="section-title">Who We Are</h2>
                    <div class="divider"></div>
                    <p class="mt-4">
                        We are a professional medical supply company committed to providing
                        high-quality medical equipment, healthcare products, and essential
                        medicines to hospitals, clinics, laboratories, pharmacies, and home users.
                    </p>
                    <p>
                        With a strong focus on quality, safety, and reliability, we aim to
                        support healthcare providers and patients with products that meet
                        international standards.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- MISSION / VISION -->
    <section class="py-5 bg-theme-light">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="highlight-box h-100">
                        <h3 class="section-title">Our Mission</h3>
                        <p class="mt-3">
                            Our mission is to make healthcare products easily accessible by
                            offering reliable medical equipment and medicines at fair prices.
                            We work to ensure safety, accuracy, and efficiency in every product
                            we deliver.
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="highlight-box h-100">
                        <h3 class="section-title">Our Vision</h3>
                        <p class="mt-3">
                            To become a leading medical supply platform recognized for trust,
                            innovation, and excellence in healthcare services across the region.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- WHAT WE OFFER -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">What We Provide</h2>
                <div class="divider"></div>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card card-custom text-center p-4 h-100">
                        <div class="icon">🩺</div>
                        <h5 class="mt-3">Medical Equipment</h5>
                        <p>
                            Diagnostic devices, hospital equipment, and home-care medical tools
                            designed for accuracy and durability.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-custom text-center p-4 h-100">
                        <div class="icon">💊</div>
                        <h5 class="mt-3">Medicines</h5>
                        <p>
                            High-quality medicines sourced from licensed and trusted
                            pharmaceutical manufacturers.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-custom text-center p-4 h-100">
                        <div class="icon">🏥</div>
                        <h5 class="mt-3">Healthcare Supplies</h5>
                        <p>
                            Complete solutions for clinics, hospitals, laboratories, and
                            pharmacies.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- QUALITY & TRUST -->
    <section class="py-5 bg-theme-light">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h2 class="section-title">Quality & Safety Assurance</h2>
                    <p class="mt-3">
                        Quality and safety are at the heart of everything we do. All our products
                        go through strict quality checks and comply with healthcare regulations.
                    </p>
                    <ul>
                        <li>Certified and approved products</li>
                        <li>Trusted manufacturers and suppliers</li>
                        <li>Safe storage and handling</li>
                        <li>Regular quality audits</li>
                    </ul>
                </div>

                <div class="col-md-6">
                    <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b"
                         class="img-fluid rounded shadow"
                         alt="Quality Assurance">
                </div>
            </div>
        </div>
    </section>

    <!-- WHY TRUST US -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">Why Trust Us</h2>
                <div class="divider"></div>
            </div>

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="card card-custom text-center p-3 h-100">
                        <h4 class="text-theme">✔</h4>
                        <p>Genuine Products</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card card-custom text-center p-3 h-100">
                        <h4>⚡</h4>
                        <p>Fast & Reliable Service</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card card-custom text-center p-3 h-100">
                        <h4>💰</h4>
                        <p>Affordable Pricing</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card card-custom text-center p-3 h-100">
                        <h4>🤝</h4>
                        <p>Customer-Centered Support</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SIMPLE JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            console.log("Detailed About Us page loaded");
        });
    </script>

</body>
</html>

