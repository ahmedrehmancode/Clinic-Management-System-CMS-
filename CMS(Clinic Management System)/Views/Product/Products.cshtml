@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/css/admin.css" rel="stylesheet" />

<style>

</style>

<div class="dashboard-container">  
    <!-- Quick Actions Section -->
    <div class="quick-actions-section">
        <div class="section-header">
            <h2>Quick Actions</h2>
        </div>
        <div class="quick-actions-grid">
            <a href="@Url.Action("Create", "Scientific")" class="action-card blue">
                <div class="action-info">
                    <h3>Add Equipment</h3>
                    <p>Scientific apparatus</p>
                </div>
                <i class="fas fa-microscope action-icon"></i>
            </a>

            <a href="@Url.Action("index", "medicine")" class="action-card teal">
                <div class="action-info">
                    <h3>Add Medicine</h3>
                    <p>Update inventory</p>
                </div>
                <i class="fas fa-pills action-icon"></i>
            </a>

            <a href="@Url.Action("Create", "Education")" class="action-card purple">
                <div class="action-info">
                    <h3>Schedule Session</h3>
                    <p>Lectures & seminars</p>
                </div>
                <i class="fas fa-calendar-plus action-icon"></i>
            </a>

            <a href="@Url.Action("Index", "Orders")" class="action-card orange">
                <div class="action-info">
                    <h3>View Orders</h3>
                    <p>Online transactions</p>
                </div>
                <i class="fas fa-shopping-bag action-icon"></i>
            </a>

            <a href="@Url.Action("Index", "Reports")" class="action-card emerald">
                <div class="action-info">
                    <h3>Generate Report</h3>
                    <p>Business analytics</p>
                </div>
                <i class="fas fa-file-chart-line action-icon"></i>
            </a>
            <a href="@Url.Action("Index", "Category")" class="action-card emerald">
                <div class="action-info">
                    <h3>Add Category</h3>
                    <p>Medicine, Machines etc</p>
                </div>
                <i class="fa-solid fa-bars action-icon"></i>
            </a>
        </div>
    </div>


    
    </div>
</div>